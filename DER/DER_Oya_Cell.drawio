        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    CLIENTE ||--o{ PEDIDO : realiza\n\n    PEDIDO ||--|{ ITEM_PEDIDO : possui\n    PRODUTO ||--o{ ITEM_PEDIDO : aparece_em\n\n    PEDIDO ||--|{ PAGAMENTO : possui\n\n    FUNCIONARIO ||--o{ FUNCIONARIO_PEDIDO : participa\n    PEDIDO ||--o{ FUNCIONARIO_PEDIDO : possui\n\n    PRODUTO ||--o{ MOVIMENTACAO_ESTOQUE : possui\n    FUNCIONARIO ||--o{ MOVIMENTACAO_ESTOQUE : registra\n\n    PAGAMENTO ||--o{ ESTORNO : pode_gerar\n\n    CLIENTE {\n        int id_cliente PK\n        string nome\n        string cpf_cnpj\n        string contato\n    }\n\n    PRODUTO {\n        int id_produto PK\n        string codigo\n        string descricao\n        string categoria\n        decimal preco\n        int quantidade_estoque\n    }\n\n    PEDIDO {\n        int id_pedido PK\n        date data_pedido\n        decimal valor_total\n        string status\n        string forma_recebimento\n        int id_cliente FK\n    }\n\n    ITEM_PEDIDO {\n        int id_item PK\n        int id_pedido FK\n        int id_produto FK\n        int quantidade\n        decimal preco_unitario\n        decimal subtotal\n    }\n\n    PAGAMENTO {\n        int id_pagamento PK\n        int id_pedido FK\n        string forma_pagamento\n        decimal valor\n        date data_pagamento\n        string status_pagamento\n    }\n\n    FUNCIONARIO {\n        int id_funcionario PK\n        string nome\n        string funcao\n    }\n\n    FUNCIONARIO_PEDIDO {\n        int id_funcionario FK\n        int id_pedido FK\n        string participacao\n    }\n\n    MOVIMENTACAO_ESTOQUE {\n        int id_movimentacao PK\n        int id_produto FK\n        int id_funcionario FK\n        string tipo_movimentacao\n        int quantidade\n        date data_movimentacao\n    }\n\n    ESTORNO {\n        int id_estorno PK\n        int id_pagamento FK\n        decimal valor_estornado\n        decimal percentual_estorno\n        date data_estorno\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="IhsXFkSCLcXAt66Ky6dw-1">
